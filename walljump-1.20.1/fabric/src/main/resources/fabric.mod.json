{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_author}"
	],
	"contributors": [
		"genandnic",
		"fzzyhmstrs"
	],
	"contact": {
		"homepage": "${mod_url}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "logo.png",
	"environment": "${side}",
	"entrypoints": {
		"main": [
          "net.camacraft.walljumpunbound.WallJumpMod"
		],
		"client": [
          "net.camacraft.walljumpunbound.WallJumpClient"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": "${loader_version_range}",
		"minecraft": "${minecraft_version_range}",
		"java": ">=17",
		"fabric-api": "*",
		"forgeconfigapiport": ">=8.0.0"
	},
	"suggests": {
		"valkyrienskies": ">=2.4.0"
	},
	"jars": [
		{"file": "META-INF/jars/keybindfixtxf-${keybindfixtxf_version}.jar"}
	]
}
